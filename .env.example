# Supabase PostgreSQL
# Project URL, e.g. https://YOUR_PROJECT.supabase.co
SUPABASE_URL=
# Service-role key: SERVER ONLY. Never expose as NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# Session signing/storage
SESSION_COOKIE_NAME=nutrikader_session
SESSION_TTL_DAYS=7

# Optional demo seed credentials. Passwords are hashed in PostgreSQL during seed.
DEMO_ADMIN_EMAIL=admin@nutrikader.id
DEMO_ADMIN_PASSWORD=admin123
DEMO_WARGA_EMAIL=warga@nutrikader.id
DEMO_WARGA_PASSWORD=warga123
